<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.HomeFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:background="?android:attr/windowBackground"
        android:layout_height="match_parent">

        <!--Show day-->
        <LinearLayout
            android:id="@+id/layout_today"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <!--DotW-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/current_day"
                android:textSize="30sp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="Monday"
                android:textStyle="bold"
                android:textColor="@color/Forest_Green"/>

            <!--Date-->
            <TextView
                android:id="@+id/current_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="20 Apr"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/Dark_Forrest_Green"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/layout_today">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:ignore="MissingConstraints">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="30dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="30dp"
                            android:id="@+id/tempTitle">

                            <TextView
                                android:id="@+id/tempText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/White"
                                android:text="Temperature"
                                android:textStyle="bold"
                                android:textSize="20sp" />

                            <ImageView
                                android:id="@+id/graph_hamburger"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/dots_horizontal"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:layout_marginTop="5dp"/>

                        </RelativeLayout>


                        <androidx.cardview.widget.CardView
                            android:id="@+id/tempCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tempTitle"
                            android:layout_marginLeft="30dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="30dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.github.mikephil.charting.charts.LineChart
                                    android:id="@+id/tempGraph"
                                    android:layout_width="match_parent"
                                    android:layout_height="200dp"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginBottom="8dp"
                                    android:layoutDirection="ltr"
                                    app:chart_grid="vertical"
                                    app:chart_labelsSize="8sp" />
                            </RelativeLayout>

                        </androidx.cardview.widget.CardView>

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="30dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginEnd="30dp"
                            android:layout_below="@+id/tempCard"
                            android:id="@+id/humidTitle">

                            <TextView
                                android:id="@+id/humidText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/White"
                                android:text="Moisture"
                                android:textStyle="bold"
                                android:textSize="20sp" />

                            <ImageView
                                android:id="@+id/graph_hamburger2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/dots_horizontal"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:layout_marginTop="5dp"/>

                        </RelativeLayout>


                        <androidx.cardview.widget.CardView
                            android:id="@+id/humidCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/humidTitle"
                            android:layout_marginLeft="30dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="30dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.github.mikephil.charting.charts.LineChart
                                    android:id="@+id/humidGraph"
                                    android:layout_width="match_parent"
                                    android:layout_height="200dp"
                                    android:layout_marginBottom="8dp"
                                    android:layoutDirection="ltr"
                                    android:layout_marginTop="8dp"
                                    app:chart_grid="vertical"
                                    app:chart_labelsSize="8sp" />
                            </RelativeLayout>

                        </androidx.cardview.widget.CardView>

                        <!--Blank Card-->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/blankCard"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginEnd="15dp"
                            android:layout_below="@id/humidCard"
                            android:backgroundTint="@android:color/transparent"
                            android:layout_alignParentBottom="true"
                            app:cardElevation="0dp" />





                    </RelativeLayout>
            </ScrollView>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>